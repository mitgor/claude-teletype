{
  "mode": "yolo",
  "parallelization": true,
  "commit_docs": true,
  "model_profile": "inherit",
  "workflow": {
    "research": false,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "_auto_chain_active": false,
    "skip_discuss": true,
    "tdd_mode": false,
    "code_review": true,
    "code_review_depth": "standard",
    "pattern_mapper": true,
    "nyquist_validation": true,
    "ui_phase": true,
    "ui_safety_gate": false,
    "ui_review": true,
    "ai_integration_phase": true,
    "research_before_questions": true,
    "use_worktrees": true
  },
  "git": {
    "branching_strategy": "none",
    "create_tag": true
  },
  "granularity": "standard",
  "model_overrides": {
    "gsd-planner": "fable",
    "gsd-roadmapper": "fable",
    "gsd-pattern-mapper": "fable",
    "gsd-executor": "fable",
    "gsd-debugger": "fable",
    "gsd-doc-writer": "fable"
  },
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true
  },
  "hooks": {
    "context_warnings": true
  }
}
